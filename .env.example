# ============================================================
# Tui Khon Backend - Environment Variables Example Template
# ============================================================

# Application Environment Profile (local / dev / prod)
APP_PROFILE=local

# Server Port
SERVER_PORT=8080

# Database Configuration - Local, Dev & Prod
POSTGRES_DB=tuikhon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TK_LOCAL_DB_URL=jdbc:postgresql://localhost:5432/tuikhon_db
TK_LOCAL_DB_USERNAME=postgres
TK_LOCAL_DB_PASSWORD=postgres
TK_DEV_DB_URL=
TK_DEV_DB_USERNAME=
TK_DEV_DB_PASSWORD=
TK_PROD_DB_URL=
TK_PROD_DB_USERNAME=
TK_PROD_DB_PASSWORD=

# Redis Configuration
TK_REDIS_HOST=localhost
TK_REDIS_PORT=6379
TK_REDIS_PASSWORD=

# Security & JWT Configuration
TK_JWT_SECRET=
TK_JWT_EXPIRY_MS=
TK_JWT_REFRESH_EXPIRY_MS=

# CORS Allowed Origins
TK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Path Configuration
LOG_PATH=./logs
